# Staging build. `vite build` loads this in production mode; VITE_* values are
# inlined into the bundle — public URLs only, no secrets.
# The all-in-one container serves the API under /api (same host) and the website
# is on a sibling subdomain.
VITE_FRONTEND_URL=https://staging.app.monno.io
VITE_API_URL_CLIENT=https://staging.app.monno.io/api
VITE_API_URL_SERVER=http://localhost/api
VITE_MONNO_SITE_URL=https://staging.monno.io
VITE_APP_NAME=monno
VITE_APP_PRIMARY_COLOR=#0B0B0C
VITE_APP_SECONDARY_COLOR=#0FCFF6
VITE_STRIPE_PUBLISHABLE_KEY=
